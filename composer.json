{
    "name": "forgemesh/pay-per-crawl-core",
    "description": "Framework-free core for ForgeMesh Pay-per-Crawl: charge AI crawlers per page with x402 / MPP USDC micropayments on Base, paid straight to your wallet.",
    "type": "library",
    "license": "MIT",
    "keywords": ["x402", "mpp", "402", "pay-per-crawl", "ai-crawlers", "usdc", "base", "paywall"],
    "homepage": "https://forgemesh.io/pay-per-crawl",
    "authors": [{"name": "ForgeMesh Labs", "homepage": "https://forgemesh.io"}],
    "support": {"issues": "https://github.com/forgemeshlabs/pay-per-crawl-php/issues", "source": "https://github.com/forgemeshlabs/pay-per-crawl-php"},
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "autoload": {"psr-4": {"ForgeMesh\\PayPerCrawl\\": "src/"}},
    "scripts": {"test": "php tests/run.php"},
    "config": {"sort-packages": true},
    "minimum-stability": "stable"
}
